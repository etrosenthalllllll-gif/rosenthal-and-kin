// Rosenthal & Kin — Core Infrastructure data model
// Implements the estate/claimant split from docs/decisions and
// "00 - Master Architecture & Index" / "01 - Core Infrastructure".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Auth / permissions (doc 01, Phase 7-8)
// ---------------------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  REVIEWER
  READ_ONLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(OPERATOR)
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  decisionsDecided Decision[]   @relation("DecisionDecidedBy")
  auditEvents      AuditEvent[]
  notes            Note[]
  sessions         Session[]
}

// Server-side session record backing the login cookie. Only a SHA-256
// hash of the session token is ever stored -- same "never store the raw
// secret" discipline as User.passwordHash, just with a cheaper hash since
// this is a high-entropy generated token, not a user-chosen password.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------
// Estate / Claimant split — see docs/decisions and doc 00 "THE DATA MODEL"
// ---------------------------------------------------------------------

enum EstateStatus {
  SOURCED
  RESEARCHING
  RESEARCH_COMPLETE
  ACTIVE
  CLOSED
}

enum FundsFlowModel {
  DIRECT_PAY
  PASS_THROUGH
}

model Estate {
  id                  String       @id @default(cuid())
  caseNumber          String       @unique // human-readable, e.g. RK-1842
  decedentName        String
  jurisdiction        String       @default("CA")
  estimatedValueCents Int?
  probateCaseNumber   String?
  filingDeadline      DateTime?
  status              EstateStatus @default(SOURCED)
  sourceTrackerRowId  String? // link back to the Sheets tracker row this came from
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  claimants             Claimant[]
  relationships         Relationship[]
  documents             Document[]
  notes                 Note[]
  verifications         Verification[]
  potentialHeirs        PotentialHeir[]
  verificationSnapshots VerificationSnapshot[]
  claimPreparations     ClaimPreparation[]
  filings               Filing[]
  postFilingCases       PostFilingCase[]
  recoveries            Recovery[]
  distributions         Distribution[]
  invoices              Invoice[]
  paymentDisputes       PaymentDispute[]

  @@index([status])
}

enum ClaimantStatus {
  LEAD
  CONTACTED
  RESPONDED
  POTENTIAL_HEIR
  VERIFIED
  ENGAGED
  DOCUMENTS_REQUESTED
  DOCUMENTS_COMPLETE
  CLAIM_READY
  AWAITING_OPERATOR_APPROVAL
  APPROVED
  FILED
  PENDING
  RECOVERY
  PAID
  CLOSED
  REJECTED
  WITHDRAWN
  ESCALATED
}

model Claimant {
  id             String         @id @default(cuid())
  estateId       String
  personId       String
  status         ClaimantStatus @default(LEAD)
  fundsFlowModel FundsFlowModel @default(DIRECT_PAY) // see docs/decisions/funds-flow-model.md
  priorityScore  Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  estate                Estate                    @relation(fields: [estateId], references: [id])
  person                Person                    @relation(fields: [personId], references: [id])
  documents             Document[]
  decisions             Decision[]
  notes                 Note[]
  transitions           ClaimantStateTransition[]
  conversations         Conversation[]
  communications        Communication[]
  verifications         Verification[]
  verificationSnapshots VerificationSnapshot[]
  claimPreparations     ClaimPreparation[]
  filings               Filing[]
  postFilingCases       PostFilingCase[]
  recoveries            Recovery[]
  distributions         Distribution[]
  invoices              Invoice[]
  paymentDisputes       PaymentDispute[]

  @@index([estateId])
  @@index([status])
}

// Every status change is validated and recorded — never mutate `status`
// directly without writing a transition row. See src/lib/stateMachine.ts.
model ClaimantStateTransition {
  id         String         @id @default(cuid())
  claimantId String
  fromStatus ClaimantStatus
  toStatus   ClaimantStatus
  actor      String // user id, or "system:<workflow-name>"
  reason     String?
  createdAt  DateTime       @default(now())

  claimant Claimant @relation(fields: [claimantId], references: [id])

  @@index([claimantId])
}

// ---------------------------------------------------------------------
// Person / relationship graph (doc 06 groundwork)
// ---------------------------------------------------------------------

model Person {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  dob       DateTime?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  claimants             Claimant[]
  relationsFrom         Relationship[]  @relation("PersonA")
  relationsTo           Relationship[]  @relation("PersonB")
  conversations         Conversation[]
  communications        Communication[]
  verificationSubjectOf Verification[]
  potentialHeirOf       PotentialHeir[]

  // doc 04 section 19 -- centralized, channel-specific communication
  // preferences. "Do not rely solely on the individual channel system":
  // doNotContact overrides every per-channel flag below regardless of
  // its own value.
  emailAllowed Boolean    @default(true)
  smsAllowed   Boolean    @default(true)
  voiceAllowed Boolean    @default(true)
  mailAllowed  Boolean    @default(true)
  doNotContact Boolean    @default(false)
  Document     Document[]
}

enum RelationshipType {
  PARENT_OF
  CHILD_OF
  SPOUSE_OF
  FORMER_SPOUSE_OF
  SIBLING_OF
  HALF_SIBLING_OF
  GRANDPARENT_OF
  GRANDCHILD_OF
  AUNT_OR_UNCLE_OF
  NIECE_OR_NEPHEW_OF
  COUSIN_OF
  OTHER
}

// ---------------------------------------------------------------------
// Verification & Heirship Analysis (doc 06) -- PLAN.md P5-1.
// ---------------------------------------------------------------------

// doc 06 section 8's own outcome set for a single relationship/identity
// claim, plus section 1's overall Verification record statuses --
// merged into one enum since both describe the same "how well is this
// supported" axis; a separate top-level UNVERIFIED/PROCESSING/
// HUMAN_VERIFIED/REJECTED/RESOLVED covers the record-lifecycle half
// doc 06 section 1 asks for, alongside section 8's finer-grained
// evidentiary outcomes.
enum VerificationStatus {
  UNVERIFIED
  PROCESSING
  STRONGLY_SUPPORTED
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONFLICTED
  INSUFFICIENT_EVIDENCE
  REQUIRES_HUMAN_REVIEW
  HUMAN_VERIFIED
  REJECTED
  RESOLVED
}

// doc 06 section 1's verification-type list.
enum VerificationType {
  IDENTITY
  RELATIONSHIP
  GENEALOGY
  ADDRESS
  DATE
  DOCUMENT
  CLAIMANT
  HEIRSHIP
  COMPETING_HEIR
  OTHER
}

model Relationship {
  id         String             @id @default(cuid())
  estateId   String
  personAId  String
  personBId  String
  type       RelationshipType
  evidence   String? // free text now; Document link comes with doc 05
  confidence Float? // 0.0 - 1.0
  // doc 06 section 6-8: a relationship isn't just "recorded," it has an
  // independent verification status and provenance -- added now that
  // P5's verification engine can actually produce/consume these.
  status     VerificationStatus @default(UNVERIFIED)
  // doc 06 section 44's source-provenance list (CLAIMANT_STATEMENT,
  // BIRTH_CERTIFICATE, RESEARCH_SOURCE, etc.) -- free text like
  // `evidence` above rather than a closed enum, since section 44's own
  // list is explicitly "examples," not exhaustive, and this needs to
  // grow without a migration every time a new source type appears.
  source     String?
  updatedAt  DateTime           @updatedAt

  estate  Estate @relation(fields: [estateId], references: [id])
  personA Person @relation("PersonA", fields: [personAId], references: [id])
  personB Person @relation("PersonB", fields: [personBId], references: [id])

  @@index([estateId])
}

// doc 06 section 1-2: a Verification record tracks one subject/claim
// under review; VerificationClaim (section 2) breaks a case down into
// individual subject-predicate-object propositions rather than one
// giant per-case yes/no, per the doc's explicit instruction.
model Verification {
  id                 String             @id @default(cuid())
  estateId           String
  claimantId         String?
  subjectPersonId    String?
  type               VerificationType
  claimText          String // human-readable claim, e.g. "Jane Smith is the daughter of John Smith."
  status             VerificationStatus @default(UNVERIFIED)
  confidence         Float? // 0.0 - 1.0
  aiRecommendation   String?
  humanDetermination String?
  reviewerId         String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  estate        Estate              @relation(fields: [estateId], references: [id])
  claimant      Claimant?           @relation(fields: [claimantId], references: [id])
  subjectPerson Person?             @relation(fields: [subjectPersonId], references: [id])
  claims        VerificationClaim[]

  @@index([estateId])
  @@index([claimantId])
}

// doc 06 section 2's individual claim -- subject/predicate/object, its
// own evidence and status independent of the parent Verification's
// overall status (a Verification can bundle several claims that don't
// all resolve the same way).
model VerificationClaim {
  id              String             @id @default(cuid())
  verificationId  String
  subjectPersonId String?
  predicate       String // e.g. "DAUGHTER_OF", "DIED_ON", "SAME_PERSON_AS"
  objectPersonId  String? // when the object is another Person
  objectValue     String? // when the object isn't a person (a date, a place, etc.)
  confidence      Float?
  status          VerificationStatus @default(UNVERIFIED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  verification Verification @relation(fields: [verificationId], references: [id])

  @@index([verificationId])
}

// doc 06 section 21's own status list, verbatim -- deliberately does
// NOT include "CONFIRMED_HEIR": section 21 explicitly warns against
// using that language "unless the appropriate human/legal workflow has
// actually made that determination."
enum PotentialHeirStatus {
  POTENTIAL
  SUPPORTED
  DISPUTED
  RULED_OUT
  REQUIRES_REVIEW
  CONFIRMED_BY_OPERATOR
}

// doc 06 sections 20-23: a candidate person whose relationship to the
// decedent might materially affect the claim, discovered independently
// of the claimant the case was originally opened for.
model PotentialHeir {
  id                     String              @id @default(cuid())
  estateId               String
  personId               String
  relationshipToDecedent String
  evidence               String?
  confidence             Float?
  discoverySource        String?
  status                 PotentialHeirStatus @default(POTENTIAL)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  estate Estate @relation(fields: [estateId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([estateId])
}

// doc 06 section 34: "At important workflow stages, create a
// verification snapshot... Future evidence should not rewrite
// historical snapshots." This model is create-only by convention: no
// code in this codebase may call `.update()` or `.delete()` on it --
// a new stage produces a new row, it never edits an old one. There is
// deliberately no `updatedAt` field, since a snapshot that could be
// updated wouldn't be a snapshot.
model VerificationSnapshot {
  id                       String   @id @default(cuid())
  estateId                 String
  claimantId               String?
  workflowStage            String // e.g. "CLAIM_PREPARATION" -- free text, mirrors documentRequirements.ts's ClaimWorkflowStage without a hard dependency on it
  identityStatus           String
  relationshipStatus       String
  competingHeirsCount      Int
  conflictsCount           Int
  requiredEvidenceComplete Boolean
  reviewStatus             String
  reviewerId               String?
  createdAt                DateTime @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id])
  claimant Claimant? @relation(fields: [claimantId], references: [id])

  @@index([estateId])
  @@index([claimantId])
}

// ---------------------------------------------------------------------
// Claim Preparation (doc 07) -- PLAN.md P6-1.
// ---------------------------------------------------------------------

// doc 07 section 1's own lifecycle, verbatim.
enum ClaimPreparationStatus {
  NOT_STARTED
  INITIALIZING
  JURISDICTION_REVIEW
  REQUIREMENTS_DETERMINED
  FORMS_SELECTED
  FORM_POPULATION
  DOCUMENT_GENERATION
  EXHIBIT_ASSEMBLY
  SIGNATURE_PENDING
  COMPLETENESS_REVIEW
  REQUIRES_OPERATOR_REVIEW
  READY_FOR_APPROVAL
  APPROVED_FOR_FILING
  FILED
  REJECTED
  SUPERSEDED
  CANCELLED
}

// doc 07 section 33's own three-way completeness output, kept as a
// real enum rather than a free-text field so callers can't introduce a
// fourth ad-hoc value.
enum ClaimCompletenessStatus {
  NOT_EVALUATED
  COMPLETE
  INCOMPLETE
  REQUIRES_REVIEW
}

// doc 07 section 1: "Create a unified ClaimPreparation entity." Decedent
// info is already on Estate (decedentName) rather than a separate
// Person-linked "decedent" record, so there's no separate decedentId
// field here -- the existing estate relation already carries it.
// requiredDocuments/selectedForms/generatedDocuments/exhibits/
// signatureRequirements from doc 07's field list will become relations
// to their own models once P6-6/P6-7/P6-11/P6-12 build them; scalar
// summary fields (ruleSetVersion, packageStatus, etc.) are added now so
// this model is usable standalone from the start.
model ClaimPreparation {
  id                     String                  @id @default(cuid())
  estateId               String
  claimantId             String
  jurisdiction           String?
  jurisdictionConfidence Float?
  claimType              String? // keys into claimTypes.ts's CLAIM_TYPES config (P6-2)
  ruleSetVersion         String? // e.g. "CA-UnclaimedProperty-v3" -- see claimRules.ts (P6-4)
  status                 ClaimPreparationStatus  @default(NOT_STARTED)
  completenessStatus     ClaimCompletenessStatus @default(NOT_EVALUATED)
  packageVersion         Int? // current ClaimPackage version, once P6-14 exists
  filingReadiness        Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  estate   Estate   @relation(fields: [estateId], references: [id])
  claimant Claimant @relation(fields: [claimantId], references: [id])

  @@index([estateId])
  @@index([claimantId])
}

// ---------------------------------------------------------------------
// Documents (doc 05 "Document Intelligence") — PLAN.md P4-1.
// OCR/classification/extraction/semantic-search themselves are
// blocked (no OCR or AI provider account exists yet, P4-7 through
// P4-9/P4-12) but the data model doc 05 section 1 asks for is added
// now regardless, since every sub-status simply sits at NOT_STARTED
// until those pipelines exist -- same reasoning P3-1 used for adding
// Person's communication-preference fields ahead of P3-6's enforcement.
// ---------------------------------------------------------------------

// doc 05 section 2's full lifecycle, verbatim. No existing code
// referenced the previous smaller enum, so this is a safe additive
// change rather than a migration hazard.
enum DocumentStatus {
  RECEIVED
  // Deprecated, kept (not removed) so `prisma db push` never treats this
  // enum change as data loss requiring --accept-data-loss -- a flag
  // Claude Code's own auto-mode classifier blocks outright. Nothing
  // reads or writes PROCESSING any more; INGESTING/OCR_PROCESSING/
  // CLASSIFYING/EXTRACTING/MATCHING/VALIDATING replace it.
  PROCESSING
  INGESTING
  OCR_PROCESSING
  CLASSIFYING
  EXTRACTING
  MATCHING
  VALIDATING
  INDEXING
  READY
  REQUIRES_REVIEW
  VERIFIED
  REJECTED
  DUPLICATE
  ARCHIVED
  FAILED
}

// doc 05 section 3's ingestion source list.
enum DocumentSource {
  EMAIL_ATTACHMENT
  SMS_MMS
  VOICE_UPLOAD
  WEBSITE_UPLOAD
  CLAIMANT_PORTAL
  OPERATOR_UPLOAD
  CLOUD_STORAGE
  RESEARCH_SOURCE
  EXTERNAL_API
  PHYSICAL_MAIL_SCAN
  OTHER
}

// Shared status for the three AI/OCR pipeline stages that are
// currently blocked (P4-7/P4-8/P4-9) -- each just sits at NOT_STARTED
// until a real provider exists to run it.
enum DocumentPipelineStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  FAILED
  SKIPPED
}

// doc 05 section 15's own output values, not a generic pipeline status
// -- validation has real semantic outcomes distinct from "did it run."
enum DocumentValidationStatus {
  NOT_VALIDATED
  VALID
  INVALID
  INCOMPLETE
  UNCERTAIN
}

// doc 05 section 22.
enum DocumentDuplicateStatus {
  NOT_CHECKED
  UNIQUE
  LIKELY_DUPLICATE
  CONFIRMED_DUPLICATE
}

// doc 05 section 32: "Separate AI PROCESSED from HUMAN VERIFIED... Do
// not represent AI extraction as human verification."
enum DocumentVerificationStatus {
  NOT_VERIFIED
  VERIFIED
  REJECTED
}

model Document {
  id                    String                      @id @default(cuid())
  estateId              String?
  claimantId            String?
  // doc 05 section 1: "Person ID where applicable" -- a document may
  // concern someone other than the claimant it's filed under (a
  // parent's birth certificate, a sibling's marriage record, etc.).
  personId              String?
  documentType          String
  // doc 05 section 3: where this document came from -- ingestion
  // paths beyond OPERATOR_UPLOAD/EMAIL_ATTACHMENT are blocked until
  // their own channel exists (P3-9/P3-10/P4-7), but the field is
  // additive schema, not a functioning pipeline.
  source                DocumentSource?
  sourceCommunicationId String? // doc 05 section 37: email -> attachment -> Document provenance
  originalFilename      String
  storageKey            String // object-storage key, never a public URL
  mimeType              String
  sizeBytes             Int
  // doc 05 section 22: exact-duplicate detection via cryptographic
  // hash -- the one piece of "duplicate detection" that needs no AI/OCR
  // (P4-3). Unique per estate below, not globally, since two different
  // estates could legitimately receive byte-identical blank forms.
  fileHash              String?
  pageCount             Int?
  status                DocumentStatus              @default(RECEIVED)
  ocrStatus             DocumentPipelineStageStatus @default(NOT_STARTED)
  classificationStatus  DocumentPipelineStageStatus @default(NOT_STARTED)
  extractionStatus      DocumentPipelineStageStatus @default(NOT_STARTED)
  validationStatus      DocumentValidationStatus    @default(NOT_VALIDATED)
  duplicateStatus       DocumentDuplicateStatus     @default(NOT_CHECKED)
  verificationStatus    DocumentVerificationStatus  @default(NOT_VERIFIED)
  // doc 05 section 34: every AI-derived result should include
  // confidence -- this is the document-level overall figure;
  // field-level confidence belongs to the (still-blocked) extraction
  // record, not this row.
  aiConfidence          Float?
  uploadedByUserId      String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  estate   Estate?   @relation(fields: [estateId], references: [id])
  claimant Claimant? @relation(fields: [claimantId], references: [id])
  person   Person?   @relation(fields: [personId], references: [id])

  @@index([estateId])
  @@index([claimantId])
  @@index([personId])
  @@index([fileHash])
}

// ---------------------------------------------------------------------
// Decisions (doc 02 groundwork)
// ---------------------------------------------------------------------

enum DecisionStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISED
  ESCALATED
  DEFERRED
  EXPIRED
  CANCELLED
  COMPLETED
}

model Decision {
  id               String         @id @default(cuid())
  claimantId       String
  decisionType     String // e.g. APPROVE_OUTREACH, REQUEST_DOCUMENTS — configurable, not an enum
  status           DecisionStatus @default(PENDING)
  priority         Int            @default(0)
  deadline         DateTime?
  aiRecommendation String?
  aiConfidence     Float?
  evidenceRefs     Json?
  availableActions Json // string[]
  selectedAction   String?
  reason           String?
  decidedByUserId  String?
  decidedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  claimant              Claimant        @relation(fields: [claimantId], references: [id])
  decidedBy             User?           @relation("DecisionDecidedBy", fields: [decidedByUserId], references: [id])
  relatedCommunications Communication[]

  @@index([claimantId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Communications (doc 04) -- channel-independent Communication +
// Conversation model. PLAN.md P3-1. Reuses CommunicationProvider's
// channel type (app/src/lib/providers/types.ts) rather than inventing a
// second one; Claimant is the "case" doc 04 refers to (matches
// Decision's own claimantId keying), Person is the participant. Doc 04
// section 2 explicitly warns not to assume one case = one person or one
// case = one conversation, so both Conversation and Communication key
// off claimantId AND personId independently rather than inferring one
// from the other.
// ---------------------------------------------------------------------

enum CommunicationChannel {
  EMAIL
  SMS
  VOICE
  MAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

// Delivery/lifecycle status -- doc 04 section 11's QUEUED/SENT/DELIVERED/
// FAILED/UNDELIVERED list, plus RECEIVED for inbound messages (which are
// never "sent" from this system's perspective) and BOUNCED (section 20).
enum CommunicationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
  BOUNCED
  RECEIVED
}

// doc 04 section 27 "UNREAD / ATTENTION SYSTEM": AUTOMATED vs
// OPERATOR_REQUIRED vs EXCEPTION. HUMAN_HANDLING is tracked separately
// below (section 30) since an operator can take over an otherwise-
// AUTOMATED conversation at any time independent of why it needed
// attention in the first place.
enum ConversationAttentionStatus {
  AUTOMATED
  OPERATOR_REQUIRED
  EXCEPTION
}

model Conversation {
  id               String                      @id @default(cuid())
  claimantId       String
  personId         String
  channel          CommunicationChannel
  attentionStatus  ConversationAttentionStatus @default(AUTOMATED)
  // doc 04 section 30 "HUMAN TAKEOVER": set true when an operator takes
  // over; pauses conflicting automation until explicitly resumed.
  humanHandling    Boolean                     @default(false)
  // Provider-side thread identifiers (email Message-ID chains, SMS
  // conversation SIDs, etc.) -- section 5 "EMAIL THREADING". Free-form
  // since the shape differs per channel/provider.
  providerThreadId String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  claimant       Claimant        @relation(fields: [claimantId], references: [id])
  person         Person          @relation(fields: [personId], references: [id])
  communications Communication[]

  @@index([claimantId])
  @@index([personId])
  @@index([attentionStatus])
}

model Communication {
  id                       String                      @id @default(cuid())
  conversationId           String
  claimantId               String
  personId                 String
  channel                  CommunicationChannel
  direction                CommunicationDirection
  sender                   String
  recipient                String
  subject                  String?
  body                     String
  attachments              Json?
  // Idempotency keys -- doc 04 section 34, "this is critical." Outbound
  // sends carry idempotencyKey (caller-generated, matches
  // OutboundMessage.idempotencyKey in providers/types.ts); inbound
  // messages carry providerMessageId (provider-generated). Both unique so
  // a retried job or a re-delivered webhook can never create a second row.
  providerMessageId        String?                     @unique
  idempotencyKey           String?                     @unique
  status                   CommunicationDeliveryStatus @default(QUEUED)
  // Configurable category string (doc 04 section 6/17's classification
  // lists), not an enum -- see communicationClassification.ts (P3-4).
  classification           String?
  classificationConfidence Float?
  aiSummary                String?
  aiConfidence             Float?
  relatedWorkflow          String?
  relatedDecisionId        String?
  relatedTaskId            String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id])
  claimant        Claimant     @relation(fields: [claimantId], references: [id])
  person          Person       @relation(fields: [personId], references: [id])
  relatedDecision Decision?    @relation(fields: [relatedDecisionId], references: [id])

  @@index([conversationId])
  @@index([claimantId])
  @@index([status])
  @@index([classification])
}

// ---------------------------------------------------------------------
// Audit trail — immutable, append-only (doc 01 Phase 6)
// ---------------------------------------------------------------------

model AuditEvent {
  id            String   @id @default(cuid())
  entityType    String // "Estate" | "Claimant" | "Document" | "Decision" | ...
  entityId      String
  eventType     String // "CREATED" | "STATUS_CHANGED" | "DOCUMENT_UPLOADED" | ...
  actorUserId   String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// Operator notes (doc 02 §13) — supplement structured data, never replace it
// ---------------------------------------------------------------------

model Note {
  id         String   @id @default(cuid())
  estateId   String?
  claimantId String?
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  estate   Estate?   @relation(fields: [estateId], references: [id])
  claimant Claimant? @relation(fields: [claimantId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------------------
// Filing & Submission (doc 08) — PLAN.md P7-1.
// Consumes an APPROVED, IMMUTABLE ClaimPackage (P6-14/P6-17) — this
// model deliberately does not duplicate anything claim preparation
// already owns. `packageId`/`packageVersion` are the exact, immutable
// reference doc 08 section 3 requires: this filing must never silently
// follow a newer package version if the package changes after
// approval — a new package version requires a fresh approval and,
// if resubmitted, a new Filing/FilingAttempt, not an update to this
// row's package reference.
// ---------------------------------------------------------------------

// doc 08 section 1's own status list, verbatim.
enum FilingStatus {
  NOT_READY
  READY_FOR_FILING
  AWAITING_APPROVAL
  APPROVED_TO_FILE
  PREPARING_SUBMISSION
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  PAYMENT_COMPLETE
  SUBMITTING
  SUBMITTED
  RECEIVED
  PROCESSING
  ACCEPTED
  PENDING
  REJECTED
  CORRECTION_REQUIRED
  RESUBMISSION_REQUIRED
  RESUBMITTED
  FAILED
  CANCELLED
  CLOSED
}

model Filing {
  id                   String       @id @default(cuid())
  estateId             String
  claimantId           String
  claimPreparationId   String
  packageId            String // ClaimPackage.claimPreparationId — packages aren't a separate Prisma model yet (P6-14 is pure logic only); this + packageVersion is the exact immutable reference
  packageVersion       Int
  jurisdiction         String
  claimType            String
  filingAuthority      String?
  filingMethod         String? // keys into a FilingMethod config table (P7-3)
  filingProvider       String? // connector/provider key (P7-4)
  providerAccount      String? // never a raw secret — a reference/label only; real credentials live outside ordinary case records (P7-5)
  status               FilingStatus @default(NOT_READY)
  externalFilingId     String?
  confirmationNumber   String?
  submissionTimestamp  DateTime?
  acceptanceTimestamp  DateTime?
  rejectionTimestamp   DateTime?
  currentAttemptNumber Int          @default(0)
  feeAmountCents       Int?
  paymentStatus        String?
  paymentReference     String?
  errorInformation     String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  estate         Estate          @relation(fields: [estateId], references: [id])
  claimant       Claimant        @relation(fields: [claimantId], references: [id])
  attempts       FilingAttempt[]
  postFilingCase PostFilingCase?

  @@index([estateId])
  @@index([claimantId])
  @@index([status])
}

// doc 08 section 2: "Never overwrite a filing attempt." Deliberately
// no `updatedAt` — every new attempt (a resubmission after correction,
// for example) is a brand-new row, same create-only discipline as
// VerificationSnapshot (P5-11).
model FilingAttempt {
  id                   String    @id @default(cuid())
  filingId             String
  attemptNumber        Int
  packageId            String
  packageVersion       Int
  provider             String?
  destination          String?
  submissionTimestamp  DateTime?
  requestReferenceId   String?
  externalConfirmation String?
  feeAmountCents       Int?
  paymentReference     String?
  responseStatus       String?
  providerResponse     String? // raw provider response, never discarded — doc 08 §31
  errorCode            String?
  errorMessage         String?
  operatorId           String?
  automationStatus     String?
  createdAt            DateTime  @default(now())

  filing Filing @relation(fields: [filingId], references: [id])

  @@unique([filingId, attemptNumber])
  @@index([filingId])
}

// doc 08 section 38: an append-only log distinct from AuditEvent --
// this one is scoped specifically to filing-status transitions and
// carries the raw provider response alongside the normalized event
// type, which AuditEvent's generic shape isn't built to hold. No
// `updatedAt` -- deliberately create-only, same discipline as
// FilingAttempt/VerificationSnapshot.
model FilingEvent {
  id             String   @id @default(cuid())
  filingId       String
  attemptId      String?
  eventType      String // e.g. FILING_CREATED, SUBMISSION_STARTED, REJECTION_RECEIVED -- doc 08's own list
  previousStatus String?
  newStatus      String?
  source         String? // e.g. "provider-webhook", "operator", "status-poll"
  rawResponse    Json?
  humanActorId   String?
  createdAt      DateTime @default(now())

  @@index([filingId])
}

// ---------------------------------------------------------------------
// Post-filing Monitoring & Case Management (doc 09) — PLAN.md P8-1.
// Transforms a filed claim into a continuously monitored case. One
// PostFilingCase per Filing (a filing either hasn't reached the
// post-filing stage yet, or has exactly one) -- doc 09 doesn't describe
// re-filing the same Filing under a second PostFilingCase.
// ---------------------------------------------------------------------

// doc 09 section 1's own status list, verbatim.
enum PostFilingCaseStatus {
  FILED
  RECEIVED
  PROCESSING
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  HEARING_SCHEDULED
  COURT_EVENT_PENDING
  DECISION_PENDING
  APPROVED
  DENIED
  SETTLEMENT_PENDING
  PAYMENT_PENDING
  COMPLETED
  CLOSED
  ESCALATED
  ON_HOLD
}

model PostFilingCase {
  id                  String               @id @default(cuid())
  filingId            String               @unique
  estateId            String
  claimantId          String
  status              PostFilingCaseStatus @default(FILED)
  currentStage        String?
  nextAction          String?
  nextDeadlineAt      DateTime?
  priority            Int                  @default(0)
  riskLevel           String?
  assignedOperatorId  String?
  monitoringStatus    String?
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime?
  lastExternalEventAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  filing   Filing   @relation(fields: [filingId], references: [id])
  estate   Estate   @relation(fields: [estateId], references: [id])
  claimant Claimant @relation(fields: [claimantId], references: [id])

  @@index([estateId])
  @@index([claimantId])
  @@index([status])
}

// doc 09 section 2: "Every state transition must create an event."
// Deliberately no `updatedAt` -- create-only, same discipline as
// FilingEvent/ClaimantStateTransition.
model PostFilingEvent {
  id               String   @id @default(cuid())
  postFilingCaseId String
  eventType        String // e.g. STATUS_UPDATED, DOCUMENT_REQUESTED, HEARING_SCHEDULED -- doc 09's own normalized list (P8-5)
  previousStatus   String?
  newStatus        String?
  source           String? // e.g. "authority-api", "operator", "status-poll"
  rawResponse      Json?
  humanActorId     String?
  createdAt        DateTime @default(now())

  @@index([postFilingCaseId])
}

// doc 09 section 14: a calendar-like court/authority event -- distinct
// from PostFilingEvent above, which is the append-only audit trail of
// this system's own status transitions. CourtEvent instead represents
// a real-world scheduled item (a hearing, a deadline, a decision) that
// itself has a mutable status as it's prepared for and completed.
enum CourtEventType {
  HEARING
  STATUS_CONFERENCE
  DEADLINE
  FILING_DEADLINE
  DOCUMENT_DEADLINE
  RESPONSE_DEADLINE
  DECISION
  MEDIATION
  CONFERENCE
  COURT_ORDER
  OTHER
}

model CourtEvent {
  id                 String         @id @default(cuid())
  postFilingCaseId   String
  eventType          CourtEventType
  externalEventId    String?
  eventDate          DateTime?
  location           String?
  authority          String?
  description        String?
  source             String?
  status             String?
  requiredAction     String?
  assignedOperatorId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([postFilingCaseId])
}

// doc 09 section 15's own status list, verbatim.
enum HearingStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
  MISSED
  UNKNOWN
}

// doc 09 sections 18-19: a reschedule or cancellation must never
// overwrite the original record. A reschedule marks this row
// RESCHEDULED and points `rescheduledToHearingId` at a brand-new row --
// it never mutates scheduledAt/location/etc. in place.
model Hearing {
  id                      String        @id @default(cuid())
  postFilingCaseId        String
  authority               String?
  hearingType             String?
  scheduledAt             DateTime?
  timeZone                String?
  location                String?
  isVirtual               Boolean?
  meetingInfo             String?
  judgeOrOfficial         String?
  requiredParticipants    Json?
  status                  HearingStatus @default(SCHEDULED)
  preparationRequirements String?
  documentsRequired       Json?
  assignedOperatorId      String?
  notes                   String?
  cancellationReason      String?
  rescheduledToHearingId  String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([postFilingCaseId])
}

// doc 09 section 26's own status list, verbatim.
enum DocumentRequestStatus {
  REQUESTED
  NOTIFIED
  AWAITING_CLAIMANT
  RECEIVED
  VALIDATING
  ACCEPTED
  REJECTED
  RESUBMISSION_REQUIRED
  CLOSED
  EXPIRED
}

model DocumentRequest {
  id                    String                @id @default(cuid())
  postFilingCaseId      String
  externalRequestId     String?
  requestedDocumentType String
  description           String?
  requestSource         String? // doc 09 sec 27's own detection-source list
  dateRequested         DateTime              @default(now())
  deadline              DateTime?
  status                DocumentRequestStatus @default(REQUESTED)
  priority              String?
  recipientId           String?
  assignedOperatorId    String?
  resolution            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([postFilingCaseId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Recovery, Distribution & Payment (doc 10) — PLAN.md P9-1.
// EXPECTED ≠ ACTUAL, INVOICE ≠ PAYMENT, PAYMENT ≠ RECONCILIATION,
// CALCULATION ≠ APPROVAL, FINANCIAL COMPLETION ≠ CASE CLOSURE — the
// doc's own central discipline, repeated throughout doc 10. Never
// collapse these into one field.
// ---------------------------------------------------------------------

// doc 10 section 1's own status list, verbatim.
enum RecoveryStatus {
  EXPECTED
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  VERIFIED
  DISTRIBUTION_PENDING
  DISTRIBUTED
  PARTIALLY_DISTRIBUTED
  DISPUTED
  CANCELLED
  UNKNOWN
}

// doc 10 section 3's own configurable source list.
enum RecoverySource {
  COURT_AUTHORITY_DISTRIBUTION
  ESTATE_DISTRIBUTION
  SETTLEMENT
  PROPERTY_RECOVERY
  ACCOUNT_RECOVERY
  INSURANCE_RECOVERY
  OTHER
}

model Recovery {
  id                  String         @id @default(cuid())
  estateId            String
  claimantId          String
  filingId            String?
  recoverySource      RecoverySource
  recoveryType        String?
  expectedAmountCents Int?
  expectedDate        DateTime?
  actualAmountCents   Int?
  actualReceiptDate   DateTime?
  currency            String         @default("USD") // doc 10 sec 59: never assume USD
  status              RecoveryStatus @default(EXPECTED)
  verificationStatus  String?
  distributionStatus  String?
  feeStatus           String?
  paymentStatus       String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  estate           Estate                    @relation(fields: [estateId], references: [id])
  claimant         Claimant                  @relation(fields: [claimantId], references: [id])
  estimateVersions RecoveryEstimateVersion[]
  actualRecoveries ActualRecovery[]
  distributions    Distribution[]
  invoices         Invoice[]

  @@index([estateId])
  @@index([claimantId])
  @@index([status])
}

// doc 10 section 4: "Never overwrite historical expectations." A
// revised estimate is always a new version -- deliberately no
// `updatedAt`, create-only, same discipline as VerificationSnapshot/
// FilingAttempt.
model RecoveryEstimateVersion {
  id                   String    @id @default(cuid())
  recoveryId           String
  version              Int
  amountCents          Int
  expectedDate         DateTime?
  source               String?
  reasonForChange      String?
  operatorOrSystem     String
  supportingDocumentId String?
  createdAt            DateTime  @default(now())

  recovery Recovery @relation(fields: [recoveryId], references: [id])

  @@unique([recoveryId, version])
  @@index([recoveryId])
}

// doc 10 sections 5-7. A Recovery can accumulate more than one reported
// receipt over time (e.g. partial receipts) -- each is its own row,
// never overwriting a prior report, same reasoning as
// RecoveryEstimateVersion.
enum ActualRecoveryStatus {
  REPORTED
  PENDING_VERIFICATION
  VERIFIED
  DISPUTED
  REVERSED
  REFUNDED
  CANCELLED
}

model ActualRecovery {
  id                        String               @id @default(cuid())
  recoveryId                String
  grossAmountCents          Int
  actualAmountReceivedCents Int
  dateReceived              DateTime?
  paymentMethod             String?
  payerSource               String?
  referenceNumber           String?
  bankPaymentReference      String?
  supportingDocumentId      String?
  currency                  String               @default("USD")
  status                    ActualRecoveryStatus @default(REPORTED)
  source                    String? // doc 10 sec 6's own detection-source list
  verifiedBy                String?
  verificationTimestamp     DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  recovery Recovery @relation(fields: [recoveryId], references: [id])

  @@index([recoveryId])
}

// doc 10 sections 10-13. "Never overwrite an approved distribution
// calculation" -- each row IS a version (same pattern as
// RecoveryEstimateVersion: a correction is a new row at `version + 1`,
// scoped to the same recoveryId + claimantId, never an edit to the
// prior one). Deliberately no `updatedAt` -- create-only.
enum DistributionStatus {
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  READY_FOR_PAYMENT
  PAYMENT_PROCESSING
  PAID
  FAILED
  DISPUTED
  CANCELLED
  RECONCILIATION_REQUIRED
}

model Distribution {
  id                      String             @id @default(cuid())
  recoveryId              String
  estateId                String
  claimantId              String // the beneficiary
  version                 Int
  grossRecoveryCents      Int
  deductionsCents         Int                @default(0)
  feesCents               Int                @default(0)
  expensesCents           Int                @default(0)
  netDistributableCents   Int
  distributionPercent     Float?
  distributionAmountCents Int
  status                  DistributionStatus @default(CALCULATED)
  approvalStatus          String?
  paymentStatus           String?
  calculationRuleId       String?
  calculationRuleVersion  String?
  createdAt               DateTime           @default(now())

  recovery Recovery @relation(fields: [recoveryId], references: [id])
  estate   Estate   @relation(fields: [estateId], references: [id])
  claimant Claimant @relation(fields: [claimantId], references: [id])

  @@unique([recoveryId, claimantId, version])
  @@index([recoveryId])
  @@index([claimantId])
}

// doc 10 sections 21-25. Invoice numbers are unique, immutable, and
// never reused -- enforced by the `@unique` constraint below alongside
// invoiceGeneration.ts's (P9-7) sequential numbering logic.
enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  VOID
  CANCELLED
  WRITTEN_OFF
}

model Invoice {
  id                          String        @id @default(cuid())
  estateId                    String
  claimantId                  String
  recoveryId                  String
  invoiceNumber               String        @unique
  invoiceDate                 DateTime      @default(now())
  dueDate                     DateTime?
  grossRecoveryCents          Int
  feeBasisDescription         String?
  feeAmountCents              Int
  otherAuthorizedChargesCents Int           @default(0)
  creditsCents                Int           @default(0)
  totalDueCents               Int
  amountPaidCents             Int           @default(0)
  amountOutstandingCents      Int
  currency                    String        @default("USD")
  status                      InvoiceStatus @default(DRAFT)
  paymentTerms                String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  estate   Estate           @relation(fields: [estateId], references: [id])
  claimant Claimant         @relation(fields: [claimantId], references: [id])
  recovery Recovery         @relation(fields: [recoveryId], references: [id])
  disputes PaymentDispute[]

  @@index([estateId])
  @@index([claimantId])
  @@index([recoveryId])
  @@index([status])
}

// doc 10 sections 40-42. Opening a dispute stops automated collection
// reminders -- see paymentDispute.ts's shouldStopCollectionReminders().
enum PaymentDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESPONDED
  RESOLVED
  ESCALATED
  CLOSED
}

model PaymentDispute {
  id                 String               @id @default(cuid())
  invoiceId          String
  estateId           String
  claimantId         String
  amountCents        Int
  reason             String?
  status             PaymentDisputeStatus @default(OPEN)
  claimantMessage    String?
  assignedOperatorId String?
  resolution         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  estate   Estate   @relation(fields: [estateId], references: [id])
  claimant Claimant @relation(fields: [claimantId], references: [id])

  @@index([invoiceId])
  @@index([status])
}
